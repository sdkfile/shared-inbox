{
  "name": "shared-inbox",
  "version": "0.1.0",
  "description": "사람과 AI가 같은 메일함을 나눠 읽는다 — AI는 메일함 상태를 바꾸지 않는다",
  "type": "module",
  "license": "MIT",
  "author": "Seonggu Kim (sdkfile)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdkfile/shared-inbox.git"
  },
  "keywords": [
    "email",
    "inbound",
    "resend",
    "webhook",
    "human-in-the-loop",
    "llm",
    "메일자동화"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
